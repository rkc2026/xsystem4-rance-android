+/*
+ * Like gfx_load_shader(), but reports failure (with a message in ERR) instead
+ * of terminating. Used for optional features such as the upscalers, which
+ * must degrade gracefully on GPUs/drivers that reject their shaders.
+ */
+static GLuint try_compile_shader(const char *path, GLenum type, char *err, size_t errlen)
+{
+	GLchar *body = SDL_LoadFile(path, NULL);
+	if (!body) {
+		char full_path[PATH_MAX];
+		snprintf(full_path, PATH_MAX, XSYS4_DATA_DIR "/%s", path);
+		body = SDL_LoadFile(full_path, NULL);
+	}
+	if (!body) {
+		snprintf(err, errlen, "cannot read %s", path);
+		return 0;
+	}
+	const GLchar *source[3] = { glsl_preamble, "", body };
+	GLuint shader = glCreateShader(type);
+	glShaderSource(shader, 3, source, NULL);
+	glCompileShader(shader);
+	SDL_free(body);
+
+	GLint ok = 0;
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		GLsizei len = 0;
+		glGetShaderInfoLog(shader, errlen, &len, err);
+		if (len <= 0)
+			snprintf(err, errlen, "compile error in %s", path);
+		glDeleteShader(shader);
+		return 0;
+	}
+	return shader;
+}
+
+bool gfx_try_load_shader(struct shader *dst, const char *vertex_shader_path,
+			 const char *fragment_shader_path, char *err, size_t errlen)
+{
+	GLuint vs = try_compile_shader(vertex_shader_path, GL_VERTEX_SHADER, err, errlen);
+	if (!vs)
+		return false;
+	GLuint fs = try_compile_shader(fragment_shader_path, GL_FRAGMENT_SHADER, err, errlen);
+	if (!fs) {
+		glDeleteShader(vs);
+		return false;
+	}
+
+	GLuint program = glCreateProgram();
+	glAttachShader(program, vs);
+	glAttachShader(program, fs);
+	glLinkProgram(program);
+	glDeleteShader(vs);
+	glDeleteShader(fs);
+
+	GLint ok = 0;
+	glGetProgramiv(program, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		GLsizei len = 0;
+		glGetProgramInfoLog(program, errlen, &len, err);
+		if (len <= 0)
+			snprintf(err, errlen, "link error");
+		glDeleteProgram(program);
+		return false;
+	}
+
+	dst->program = program;
+	dst->world_transform = glGetUniformLocation(program, "world_transform");
+	dst->view_transform = glGetUniformLocation(program, "view_transform");
+	dst->texture = glGetUniformLocation(program, "tex");
+	dst->vertex_pos = glGetAttribLocation(program, "vertex_pos");
+	dst->vertex_uv = glGetAttribLocation(program, "vertex_uv");
+	dst->prepare = NULL;
+	return true;
+}
